# Copy values into an owned0600 production.env in a private0700 directory OUTSIDE Git.
# This is a reference-only template; production:config refuses the placeholder revision.
MONEY_SEASONS_PRODUCTION_REPO=/absolute/canonical/money-seasons
MONEY_SEASONS_RELEASE=REPLACE_WITH_EXACT_40_CHARACTER_MAIN_COMMIT
MONEY_SEASONS_DATA_DIR=/absolute/private/money-seasons-production/data
MONEY_SEASONS_PASSPHRASE_FILE=/absolute/private/money-seasons-production/passphrase
MONEY_SEASONS_CADDY_DIR=/absolute/private/money-seasons-production/caddy
# Root-local profile (compatible with existing config; empty or omitted prefix):
MONEY_SEASONS_BASE_PATH=
MONEY_SEASONS_ORIGINS=https://localhost:3443
# For the separately authorized tailnet + retained local fallback cutover, REPLACE the
# two lines above (do not duplicate keys) with exactly:
# MONEY_SEASONS_BASE_PATH=/lichtaichinh
# MONEY_SEASONS_ORIGINS=https://drgnfly.tail10c2c6.ts.net,https://localhost:3443
# Proxy profile is derived by production:*; do not add MONEY_SEASONS_PROXY_PROFILE here.
MONEY_SEASONS_DOCKER_HOST=unix:///run/docker.sock
MONEY_SEASONS_DOCKER_ID=OPERATOR_VERIFIED_DAEMON_ID
# MS-005 explicit member mode (omit these keys to retain legacy shared login):
# MONEY_SEASONS_AUTH_MODE=members
# MONEY_SEASONS_MEMBERS_DIR=/absolute/private/money-seasons-production/release/members
# MONEY_SEASONS_ROLES_FILE=/absolute/private/money-seasons-production/release/roles/roles.json
# Provision owned 0700 directories / 0600 files outside Git first. Finance,
# membership and operator-role locations must be separate. No passwords here.
